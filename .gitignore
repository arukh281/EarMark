# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Caches, datasets and checkpoints (see scripts/env.sh)
.cache/
data/
checkpoints/

# C++ and WebAssembly builds
build/
engine/build/

# Node and Playwright
node_modules/
test-results/
playwright-report/

# macOS
.DS_Store

# Secrets
.env
.env.*

# Earmark scaffold additions.
# The data/ rule above is meant for the dataset directory; keep the source packages.
!python/earmark/data/
!tests/data/
.ruff_cache/
.mypy_cache/
.coverage
engine/build-*/

# Run-book artefacts, wherever they land: converted notebooks (the jupytext .py files are
# the source), enrolment embeddings, checkpoints, ONNX exports and scored audio.
*.ipynb
*.npz
*.pt
*.onnx
/results/**/*.wav
# Small fixtures a test needs may still be committed under tests/.
!tests/**/*.npz
!tests/**/*.wav
